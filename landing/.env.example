# Server-only values. Never prefix these with VITE_.
MODEL_API_KEY=
# Private operator access code required before any billable analysis call.
ANALYSIS_ACCESS_TOKEN=
# Separate owner-managed Bearer token for live MCP analysis. Do not reuse the
# operator code. Public capabilities and sample tools need no credentials.
MCP_ACCESS_TOKEN=
# Optional comma-separated browser origins. Native robot clients omit Origin.
MCP_ALLOWED_ORIGINS=
