{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/", "destination": "/index.html" }
  ]
}
